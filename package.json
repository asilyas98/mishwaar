{
  "name": "mishwaar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync:ios": "npm run build && node --input-type=module -e \"import { writeFileSync } from 'node:fs'; writeFileSync('capacitor.config.json', JSON.stringify({ appId: 'com.simpleai.mishwaar', appName: 'Mishwaar', webDir: 'dist' }, null, 2));\" && (test -d ios/App || npx cap add ios) && npx cap sync ios",
    "open:ios": "cap open ios",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "node scripts/seed-osm.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@supabase/supabase-js": "^2.117.2",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
