# Leave these empty to run in demo mode (accounts and ratings stay on this device).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: your own map tile server (MapTiler, Stadia, self-hosted…). It is tried first;
# if left empty the app uses OpenStreetMap, then Esri. See README.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=

# Push notifications (taxi). Generate a key pair with:  npx web-push generate-vapid-keys
# The public key goes here; the private key only goes in Netlify (see README).
VITE_VAPID_PUBLIC_KEY=
